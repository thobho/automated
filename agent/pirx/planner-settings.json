{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-tree *)",
      "Bash(git grep *)",
      "Bash(git diff *)",
      "Bash(gh issue create *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(jq *)",
      "Bash(date *)"
    ],
    "deny": [
      "Edit",
      "Write",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git reset *)",
      "Bash(git config *)",
      "Bash(gh issue close *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue delete *)",
      "Bash(gh issue transfer *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr create *)",
      "Bash(gh api *)",
      "Bash(gh repo *)",
      "Bash(gh auth *)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/automated/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.ssh/**)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
