# Copy to .env for local development: cp .env.example .env
# dev settings read .env; prod never does (set real env vars there).
# Never commit .env or real secrets.

# Settings module is chosen by the DJANGO_SETTINGS_MODULE env var (not by this file):
# manage.py defaults to config.settings.dev, wsgi/asgi to config.settings.prod,
# pytest to config.settings.test.

# --- Required in prod (startup fails naming the first missing one) ---
# Long random string. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Comma-separated host names
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL 17. dev defaults to postgres://artysci:artysci@localhost:5432/artysci
# test falls back to in-memory SQLite when unset; dev and prod never do.
DATABASE_URL=postgres://artysci:artysci@localhost:5432/artysci

# --- Optional (defaults shown) ---
# dev only; prod is always false
# DJANGO_DEBUG=true
# Seconds to keep DB connections open
# DATABASE_CONN_MAX_AGE=60
# prod: comma-separated origins with scheme, e.g. https://artysci.example
# DJANGO_CSRF_TRUSTED_ORIGINS=
# dev: e-mail backend (console prints mails)
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Static files URL and absolute collectstatic target (default: <project>/staticfiles)
# DJANGO_STATIC_URL=/static/
# DJANGO_STATIC_ROOT=/srv/artysci/staticfiles
