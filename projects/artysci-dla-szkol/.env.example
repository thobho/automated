# Copy to .env for local development: cp .env.example .env
# dev settings read .env; prod never does (set real env vars there).
# Never commit .env or real secrets.

# Settings module is chosen by the DJANGO_SETTINGS_MODULE env var (not by this file):
# manage.py defaults to config.settings.dev, wsgi/asgi to config.settings.prod,
# pytest to config.settings.test.

# --- Required in prod (startup fails naming the first missing one) ---
# Long random string. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Comma-separated host names
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL 17. Matches the lite Compose stack (127.0.0.1:54320); dev defaults to the same.
# test falls back to in-memory SQLite when unset; dev and prod never do.
DATABASE_URL=postgres://artysci:artysci@127.0.0.1:54320/artysci

# --- Optional (defaults shown) ---
# dev only; prod is always false
# DJANGO_DEBUG=true
# Seconds to keep DB connections open
# DATABASE_CONN_MAX_AGE=60
# prod: comma-separated origins with scheme, e.g. https://artysci.example
# DJANGO_CSRF_TRUSTED_ORIGINS=
# prod TLS (SECURITY.md). Redirect HTTP to HTTPS (off only for local plain-HTTP containers)
# DJANGO_SECURE_SSL_REDIRECT=true
# Set true only behind a proxy that overwrites X-Forwarded-Proto
# DJANGO_TRUST_X_FORWARDED_PROTO=false
# HSTS max-age in seconds (one year), includeSubDomains, preload (owner decision, hard to undo)
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=false
# Log level for the JSON logs on stdout (all environments)
# LOG_LEVEL=INFO
# E-mail login (US-1.3): link/code lifetime (s); failed codes per e-mail before a lock, lock window (s)
# LOGIN_CHALLENGE_TTL=900
# LOGIN_THROTTLE_LIMIT=5
# LOGIN_THROTTLE_WINDOW=900
# Login e-mails per address and per client IP within the window (s)
# LOGIN_EMAIL_LIMIT_PER_ADDRESS=5
# LOGIN_EMAIL_LIMIT_PER_IP=20
# LOGIN_EMAIL_WINDOW=3600
# E-mail change requests per user within LOGIN_EMAIL_WINDOW (US-1.6)
# EMAIL_CHANGE_LIMIT_PER_USER=5
# Wrong preview-link tokens per client IP within the window (s) before /podglad/ answers 429 (US-3.7)
# PREVIEW_LIMIT_PER_IP=20
# PREVIEW_LIMIT_WINDOW=900
# Session lifetime after the last request (s), 30 days
# SESSION_COOKIE_AGE=2592000
# Sender of e-mails
# DEFAULT_FROM_EMAIL=Artyści dla szkół <no-reply@localhost>
# dev: e-mail backend (console prints mails)
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# SMTP host/port for the smtp e-mail backend (Mailpit in Compose: mailpit:1025 inside, 127.0.0.1:12025 outside)
# EMAIL_HOST=localhost
# EMAIL_PORT=25

# --- Quality lab (US-11.2) ---
# true allows the synthetic test set commands (testset_check, testset_load) and creates
# `testset-<slug>@example.invalid` artists. Default false; on in the dev, test and pirx settings.
# Never turn it on in production.
# QUALITY_LAB_ENABLED=false

# --- AI adapter (apps/profiles/ai). Defaults shown. ---
# fake = deterministic, offline (dev/test default); openrouter = real calls (prod default)
# AI_CLIENT=fake
# OpenRouter key for the app (a dev key with a low limit locally). Env only, never logged.
# OPENROUTER_API_KEY=
# Kill switch: true stops every AI call (AIDisabled), nothing is sent
# AI_KILL_SWITCH=false
# Global daily cap (Europe/Warsaw day) and the most a single call may cost, in USD
# AI_DAILY_CAP_USD=1.00
# AI_PER_CALL_CAP_USD=0.05
# Pinned model and the providers OpenRouter may use (comma-separated, ZDR endpoints)
# AI_MODEL=anthropic/claude-haiku-5.5
# AI_PROVIDERS=google-vertex,amazon-bedrock
# Price ceiling of AI_MODEL in USD per million tokens (cost estimate and provider max_price)
# AI_PRICE_PROMPT_USD_PER_MTOK=0.11
# AI_PRICE_COMPLETION_USD_PER_MTOK=0.55
# AI_MAX_TOKENS=2048
# AI_TIMEOUT_SECONDS=60
# Extra names to remove from every prompt, comma-separated
# AI_SCRUB_NAMES=

# --- Local Compose stack (compose.yaml, Makefile). All ports bind to 127.0.0.1; defaults avoid
# --- the services already on pirx (3000, 5037, 8080, 8384, 22000). Defaults shown.
# postgres/minio data, outside the repo (use ${HOME}, not $HOME: Make would misread the latter)
# ARTYSCI_STATE_DIR=${HOME}/runtime/artysci-dla-szkol
# POSTGRES_USER=artysci
# POSTGRES_PASSWORD=artysci
# POSTGRES_DB=artysci
# POSTGRES_PORT=54320
# MAILPIT_SMTP_PORT=12025
# MAILPIT_UI_PORT=18025
# MINIO_ROOT_USER=artysci
# MINIO_ROOT_PASSWORD=artysci-minio-dev
# MINIO_PORT=19000
# MINIO_CONSOLE_PORT=19001
# WEB_PORT=18000          # web container (full); `make web` uses WEB_NATIVE_PORT
# WEB_NATIVE_PORT=18001

# --- Public origin (US-3.4): canonical links, Open Graph and sitemap URLs. No trailing slash.
# REQUIRED in prod; pirx defaults to its LAN address, dev/test to http://localhost:8000, compose
# "full" to http://localhost:18000.
# SITE_URL=https://artysci.example.pl

# --- Media storage (T06). Private = signed URLs only; public = separate origin.
# STORAGE_BACKEND=filesystem   # or s3 (MinIO in Compose full / CI; any S3-compatible service)
# Origin that serves public files; must differ from the app's origin. REQUIRED in prod.
# filesystem: run `uv run python manage.py serve_public_media --port 8101` (set host 0.0.0.0 to share)
# s3: the public bucket's URL, e.g. http://127.0.0.1:19000/public/
# MEDIA_PUBLIC_BASE_URL=http://localhost:8101/
# MEDIA_PRIVATE_ROOT=/srv/artysci/media/private   # filesystem backend
# MEDIA_PUBLIC_ROOT=/srv/artysci/media/public     # filesystem backend
# MEDIA_SIGNED_URL_TTL=300     # seconds a private-file link stays valid
# s3 only (create the buckets with: python manage.py ensure_buckets)
# S3_ENDPOINT_URL=http://127.0.0.1:19000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PRIVATE_BUCKET=private
# S3_PUBLIC_BUCKET=public
# S3_REGION=us-east-1
# S3_ADDRESSING_STYLE=path

# --- Malware scanning of uploads (apps/core/scanning.py, US-2.3A). Defaults shown.
# clamd = ClamAV daemon (prod: the only value allowed, and the default there);
# none = nothing scanned, every file logged as upload_unscanned (dev and pirx default, D87)
# MALWARE_SCANNER=none
# clamd over TCP (prod without CLAMD_HOST or CLAMD_SOCKET: every scan fails, nothing becomes ready)
# CLAMD_HOST=
# CLAMD_PORT=3310
# clamd over a Unix socket (wins over host/port), e.g. /run/clamav/clamd.ctl
# CLAMD_SOCKET=
# CLAMD_TIMEOUT=30
# PDF text extraction limits (pages, characters, seconds) and the oEmbed timeout (s)
# PDF_TEXT_MAX_PAGES=100
# PDF_TEXT_MAX_CHARS=100000
# PDF_TEXT_MAX_SECONDS=30
# OEMBED_TIMEOUT_SECONDS=5
# Note: clamd scans streams only up to its StreamMaxLength (default 25 MB); 500 MB videos need
# that raised on the host (owner decision with hosting, D87).

# --- Video and audio materials (US-2.3B). Defaults shown.
# Resumable uploads: chunks are written here (never a served storage), one file per session;
# chunk size in bytes; sessions expire after this many hours (an hourly job deletes them).
# UPLOAD_TEMP_DIR=/tmp/artysci-uploads
# UPLOAD_CHUNK_BYTES=4194304
# UPLOAD_SESSION_TTL_HOURS=24
# ffmpeg / ffprobe binaries and their limits (wall clock in seconds, address space in MB)
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# FFMPEG_TIMEOUT_SECONDS=900
# FFPROBE_TIMEOUT_SECONDS=30
# FFMPEG_MEMORY_MB=1536
# FFMPEG_THREADS=2
# Scratch directory for ffmpeg input/output (empty = the system temp directory)
# MEDIA_WORK_DIR=
# Import from the artist's website (US-2.2): pages per import, total bytes incl. photos,
# seconds per request, redirects per request, characters of text kept
# WEBSITE_IMPORT_MAX_PAGES=10
# WEBSITE_IMPORT_MAX_BYTES=20971520
# WEBSITE_IMPORT_PAGE_TIMEOUT=30
# WEBSITE_IMPORT_MAX_REDIRECTS=3
# WEBSITE_IMPORT_MAX_TEXT_CHARS=200000
# Dev/test only: let the importer reach 127.0.0.1 on any port (a local synthetic site).
# Prod and pirx refuse to start with it set to true.
# SAFE_FETCH_ALLOW_LOOPBACK=false

# Static files URL and absolute collectstatic target (default: <project>/staticfiles)
# DJANGO_STATIC_URL=/static/
# DJANGO_STATIC_ROOT=/srv/artysci/staticfiles
