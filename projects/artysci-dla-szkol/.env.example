# Copy to .env for local development: cp .env.example .env
# dev settings read .env; prod never does (set real env vars there).
# Never commit .env or real secrets.

# Settings module is chosen by the DJANGO_SETTINGS_MODULE env var (not by this file):
# manage.py defaults to config.settings.dev, wsgi/asgi to config.settings.prod,
# pytest to config.settings.test.

# --- Required in prod (startup fails naming the first missing one) ---
# Long random string. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Comma-separated host names
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL 17. Matches the lite Compose stack (127.0.0.1:54320); dev defaults to the same.
# test falls back to in-memory SQLite when unset; dev and prod never do.
DATABASE_URL=postgres://artysci:artysci@127.0.0.1:54320/artysci

# --- Optional (defaults shown) ---
# dev only; prod is always false
# DJANGO_DEBUG=true
# Seconds to keep DB connections open
# DATABASE_CONN_MAX_AGE=60
# prod: comma-separated origins with scheme, e.g. https://artysci.example
# DJANGO_CSRF_TRUSTED_ORIGINS=
# prod TLS (SECURITY.md). Redirect HTTP to HTTPS (off only for local plain-HTTP containers)
# DJANGO_SECURE_SSL_REDIRECT=true
# Set true only behind a proxy that overwrites X-Forwarded-Proto
# DJANGO_TRUST_X_FORWARDED_PROTO=false
# HSTS max-age in seconds (one year), includeSubDomains, preload (owner decision, hard to undo)
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=false
# Log level for the JSON logs on stdout (all environments)
# LOG_LEVEL=INFO
# Login throttling (E1): failed attempts allowed per key, and the window in seconds
# LOGIN_THROTTLE_LIMIT=5
# LOGIN_THROTTLE_WINDOW=900
# dev: e-mail backend (console prints mails)
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# SMTP host/port for the smtp e-mail backend (Mailpit in Compose: mailpit:1025 inside, 127.0.0.1:12025 outside)
# EMAIL_HOST=localhost
# EMAIL_PORT=25

# --- AI adapter (apps/profiles/ai). Defaults shown. ---
# fake = deterministic, offline (dev/test default); openrouter = real calls (prod default)
# AI_CLIENT=fake
# OpenRouter key for the app (a dev key with a low limit locally). Env only, never logged.
# OPENROUTER_API_KEY=
# Kill switch: true stops every AI call (AIDisabled), nothing is sent
# AI_KILL_SWITCH=false
# Global daily cap (Europe/Warsaw day) and the most a single call may cost, in USD
# AI_DAILY_CAP_USD=1.00
# AI_PER_CALL_CAP_USD=0.05
# Pinned model and the providers OpenRouter may use (comma-separated, ZDR endpoints)
# AI_MODEL=anthropic/claude-haiku-5.5
# AI_PROVIDERS=google-vertex,amazon-bedrock
# Price ceiling of AI_MODEL in USD per million tokens (cost estimate and provider max_price)
# AI_PRICE_PROMPT_USD_PER_MTOK=0.11
# AI_PRICE_COMPLETION_USD_PER_MTOK=0.55
# AI_MAX_TOKENS=2048
# AI_TIMEOUT_SECONDS=60
# Extra names to remove from every prompt, comma-separated
# AI_SCRUB_NAMES=

# --- Local Compose stack (compose.yaml, Makefile). All ports bind to 127.0.0.1; defaults avoid
# --- the services already on pirx (3000, 5037, 8080, 8384, 22000). Defaults shown.
# postgres/minio data, outside the repo (use ${HOME}, not $HOME: Make would misread the latter)
# ARTYSCI_STATE_DIR=${HOME}/runtime/artysci-dla-szkol
# POSTGRES_USER=artysci
# POSTGRES_PASSWORD=artysci
# POSTGRES_DB=artysci
# POSTGRES_PORT=54320
# MAILPIT_SMTP_PORT=12025
# MAILPIT_UI_PORT=18025
# MINIO_ROOT_USER=artysci
# MINIO_ROOT_PASSWORD=artysci-minio-dev
# MINIO_PORT=19000
# MINIO_CONSOLE_PORT=19001
# WEB_PORT=18000          # web container (full); `make web` uses WEB_NATIVE_PORT
# WEB_NATIVE_PORT=18001

# Static files URL and absolute collectstatic target (default: <project>/staticfiles)
# DJANGO_STATIC_URL=/static/
# DJANGO_STATIC_ROOT=/srv/artysci/staticfiles
