{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pakiet testowy generatora v1",
  "description": "One synthetic artist material package of the generator test set (US-11.2). Closed: unknown keys are errors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug", "origin", "level", "artist", "questionnaire", "offers", "site_text",
    "documents", "videos", "photos", "expectations"
  ],
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60},
    "description": {"type": "string", "maxLength": 300},
    "origin": {"enum": ["synthetic", "consented"]},
    "level": {"enum": ["weak", "medium", "rich"]},
    "artist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "city", "voivodeships", "audiences"],
      "properties": {
        "type": {"enum": ["theatre", "illusion", "music", "science_show", "animal_show", "workshops", "other"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "city": {"type": "string", "minLength": 1, "maxLength": 100},
        "voivodeships": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "audiences": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["kindergarten", "grades_0_3", "grades_4_6", "grades_7_8", "secondary", "families"]}
        }
      }
    },
    "questionnaire": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "q_age_from": {"type": ["integer", "null"]},
        "q_age_to": {"type": ["integer", "null"]},
        "q_duration_minutes": {"type": ["integer", "null"]},
        "q_max_audience": {"type": ["integer", "null"]},
        "q_tech_room": {"type": "string"},
        "q_tech_power": {"type": "string"},
        "q_tech_sound": {"type": "string"},
        "q_price_from_pln": {"type": ["integer", "null"]},
        "q_price_to_pln": {"type": ["integer", "null"]},
        "q_price_on_request": {"type": "boolean"}
      }
    },
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "age_from": {"type": ["integer", "null"]},
          "age_to": {"type": ["integer", "null"]},
          "duration_minutes": {"type": ["integer", "null"]},
          "price_pln": {"type": ["integer", "null"]},
          "price_on_request": {"type": "boolean"}
        }
      }
    },
    "site_text": {"type": "string"},
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "text"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "title"],
        "properties": {
          "url": {"type": "string", "minLength": 1},
          "title": {"type": "string", "maxLength": 300}
        }
      }
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {"enum": ["normal", "low_resolution", "poster", "screenshot"]},
          "width": {"type": "integer", "minimum": 100, "maximum": 4000},
          "height": {"type": "integer", "minimum": 100, "maximum": 4000}
        }
      }
    },
    "expectations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {"enum": ["field_empty", "field_not_empty", "text_absent", "text_present", "no_price", "gap_reported"]},
          "path": {"type": "string"},
          "text": {"type": "string", "minLength": 1},
          "code": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
