[Unit]
Description=artysci dev: Postgres and Mailpit containers (127.0.0.1 only)
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@PROJECT@
EnvironmentFile=%h/.config/artysci-dla-szkol/pirx.env
# ensure-db.sh repairs in place here; everywhere else it restarts this unit (containers must
# live in this unit's cgroup, see ensure-db.sh)
Environment=ENSURE_DB_IN_UNIT=1
ExecStart=/usr/bin/podman compose --profile lite up -d
ExecStartPost=/usr/bin/bash @PROJECT@/deploy/pirx/ensure-db.sh
ExecStop=/usr/bin/podman compose --profile lite stop
TimeoutStartSec=300

[Install]
WantedBy=default.target
