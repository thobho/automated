# Copy to ~/.config/artysci-dla-szkol/pirx.env (done by `make install-units-pirx`, which also
# generates DJANGO_SECRET_KEY). Never commit the real file. Synthetic data only (D57).
DJANGO_SETTINGS_MODULE=config.settings.pirx
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=192.168.68.62,localhost,127.0.0.1
DATABASE_URL=postgres://artysci:artysci@127.0.0.1:54320/artysci
# Mail goes only to Mailpit (UI on 127.0.0.1:18025)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=12025
STORAGE_BACKEND=filesystem
MEDIA_PUBLIC_BASE_URL=http://192.168.68.62:8101/
SITE_URL=http://192.168.68.62:18001
MEDIA_PRIVATE_ROOT=/home/agent/runtime/artysci-dla-szkol/media/private
MEDIA_PUBLIC_ROOT=/home/agent/runtime/artysci-dla-szkol/media/public
DJANGO_STATIC_ROOT=/home/agent/runtime/artysci-dla-szkol/staticfiles
# No clamd on pirx in light mode (~1 GB RAM, D87): uploads are logged as upload_unscanned.
MALWARE_SCANNER=none
ARTYSCI_STATE_DIR=/home/agent/runtime/artysci-dla-szkol
# AI: dev key with a low spending limit only. Leave unset until the AI task needs it.
# ANTHROPIC_API_KEY=
