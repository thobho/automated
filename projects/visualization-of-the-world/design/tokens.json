      }
    }
  },

  "data": {
    "note": "Data colours are shared by all three directions so a chart means the same thing whichever look is active. Values come from the dataviz skill's validated reference palette and are re-validated against our own surfaces by scripts/check_contrast.py.",
    "categorical": {
      "names": ["blue", "orange", "aqua", "yellow", "magenta", "green", "violet", "red"],
      "light": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948"],
      "dark": ["#3987e5", "#d95926", "#199e70", "#c98500", "#d55181", "#008300", "#9085e9", "#e66767"]
    },
    "placeType": {
      "note": "Big cities / small cities / villages = categorical slots 1-3, the only three slots that pass the all-pairs colour-blind check, so they can sit anywhere next to each other (maps, scatter, small multiples).",
      "keys": ["big-cities", "small-cities", "villages"],
      "labels": { "big-cities": "Duże miasta", "small-cities": "Małe miasta", "villages": "Wsie" },
      "light": ["#2a78d6", "#eb6834", "#1baf7a"],
      "dark": ["#3987e5", "#d95926", "#199e70"]
    },
    "sequential": {
      "blue": {
        "100": "#cde2fb", "150": "#b7d3f6", "200": "#9ec5f4", "250": "#86b6ef", "300": "#6da7ec", "350": "#5598e7", "400": "#3987e5",
        "450": "#2a78d6", "500": "#256abf", "550": "#1c5cab", "600": "#184f95", "650": "#104281", "700": "#0d366b"
      },
      "red": {
        "100": "#fbd5d1", "150": "#f6c2bd", "200": "#f3ada7", "250": "#ec9992", "300": "#e7837c", "350": "#e06e68", "400": "#da5450",
        "450": "#ca4442", "500": "#b43b3a", "550": "#a1302f", "600": "#8c2828", "650": "#781e1f", "700": "#641819"
      }
    },
    "diverging": {
      "note": "Red (decrease) <- neutral grey -> blue (increase). Arms are the red and blue ramps at the same OKLCH lightness, so neither side shouts louder.",
      "light": ["#8c2828", "#da5450", "#f3ada7", "#e6ebef", "#9ec5f4", "#3987e5", "#184f95"],
      "dark": ["#f3ada7", "#e06e68", "#a1302f", "#38434c", "#1c5cab", "#5598e7", "#9ec5f4"]
    },
    "map": {
      "note": "Seven-class choropleth, one hue. Light: pale = low, dark = high. Dark: the anchor flips so low values recede into the dark surface. No-data regions use the theme's map-nodata fill plus a hatch, never a ramp colour.",
      "light": ["#cde2fb", "#9ec5f4", "#6da7ec", "#3987e5", "#256abf", "#184f95", "#0d366b"],
      "dark": ["#0d366b", "#184f95", "#256abf", "#3987e5", "#6da7ec", "#9ec5f4", "#cde2fb"]
    },
    "status": {
      "note": "Reserved meanings; always shipped with an icon and a text label, never colour alone. Fills for marks and badges; text uses the theme's *-text tokens.",
      "good": "#0ca30c", "warning": "#fab219", "serious": "#ec835a", "critical": "#d03b3b"
    }
  },

  "typography": {
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "scale": {
      "xs": { "size": "0.75rem", "line": "1.4", "use": "axis ticks, chart source footer, legal" },
      "sm": { "size": "0.875rem", "line": "1.45", "use": "UI labels, table cells, tooltips, captions" },
      "md": { "size": "1rem", "line": "1.55", "use": "UI body, form fields" },
      "story": { "size": "clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem)", "line": "1.65", "use": "long-form story text" },
      "lg": { "size": "1.25rem", "line": "1.4", "use": "chart titles, card titles" },
      "xl": { "size": "clamp(1.375rem, 1.15rem + 1vw, 1.75rem)", "line": "1.25", "use": "section headings (h3)" },
      "2xl": { "size": "clamp(1.75rem, 1.35rem + 1.8vw, 2.5rem)", "line": "1.15", "use": "chapter headings (h2)" },
      "3xl": { "size": "clamp(2.25rem, 1.55rem + 3.2vw, 3.75rem)", "line": "1.05", "use": "page and landing headline (h1)" },
      "figure": { "size": "clamp(2.5rem, 1.7rem + 4vw, 4.5rem)", "line": "1", "use": "hero number / stat tile value" }
    },
    "tracking": { "display": "-0.02em", "body": "0", "caps": "0.04em" },
    "measure": "38rem"
  },

  "space": { "0": "0", "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.5rem", "6": "2rem", "7": "3rem", "8": "4rem", "9": "6rem" },
  "radius": { "none": "0", "xs": "2px", "sm": "4px", "md": "6px", "lg": "10px", "mark": "4px" },
  "shadow": {
    "light": {
      "sm": "0 1px 2px rgb(11 16 20 / 0.06)",
      "md": "0 2px 6px rgb(11 16 20 / 0.08), 0 8px 24px rgb(11 16 20 / 0.08)",
      "lg": "0 12px 40px rgb(11 16 20 / 0.18)"
    },
    "dark": {
      "sm": "0 1px 2px rgb(0 0 0 / 0.4)",
      "md": "0 2px 6px rgb(0 0 0 / 0.45), 0 8px 24px rgb(0 0 0 / 0.35)",
      "lg": "0 12px 40px rgb(0 0 0 / 0.6)"
    }
  },
  "motion": {
    "duration": { "instant": "80ms", "fast": "140ms", "base": "220ms", "slow": "360ms", "story": "600ms" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0, 1)",
      "exit": "cubic-bezier(0.3, 0, 1, 1)"
    },
    "playStepMs": 450,
    "reducedMotion": "All durations become 0ms; skeleton shimmer stops; story scroll uses instant jumps; the year player still steps (user-started) but without tweening."
  },
  "layout": {
    "breakpoints": { "md": "600px", "lg": "960px", "xl": "1280px" },
    "columns": { "base": 4, "md": 8, "lg": 12 },
    "gutter": { "base": "1rem", "md": "1.5rem", "lg": "1.5rem" },
    "margin": { "base": "1rem", "md": "1.5rem", "lg": "2rem" },
    "maxWidth": "75rem",
    "topBarHeight": "3.5rem",
    "touchTarget": "44px"
  },

  "contrast": {
    "note": "Rules checked by scripts/check_contrast.py for every direction x theme. WCAG 2.2 AA: 4.5:1 normal text, 3:1 large text and non-text UI (1.4.3, 1.4.11). Data marks: 3:1 against the chart surface.",
    "textOn": ["bg-page", "bg-surface", "bg-sunken", "bg-raised"],
    "text": ["text-primary", "text-secondary", "text-muted", "accent-text", "link", "chart-text", "chart-annotation", "success-text", "warning-text", "danger-text", "info-text"],
    "pairs": [
      { "fg": "text-on-accent", "bg": "accent", "min": 4.5 },
      { "fg": "text-on-accent", "bg": "accent-hover", "min": 4.5 },
      { "fg": "text-inverse", "bg": "bg-inverse", "min": 4.5 },
      { "fg": "accent-text", "bg": "accent-subtle", "min": 4.5 },
      { "fg": "text-primary", "bg": "accent-subtle", "min": 4.5 },
      { "fg": "success-text", "bg": "success-subtle", "min": 4.5 },
      { "fg": "warning-text", "bg": "warning-subtle", "min": 4.5 },
      { "fg": "danger-text", "bg": "danger-subtle", "min": 4.5 },
      { "fg": "info-text", "bg": "info-subtle", "min": 4.5 }
    ],
    "uiOn": ["bg-page", "bg-surface", "bg-raised"],
    "ui": ["border-strong", "focus-ring", "accent"],
    "dataMin": 3.0,
    "rampMinDeltaL": 0.06,
    "exceptions": [
      { "set": "categorical", "theme": "light", "color": "#1baf7a", "reason": "Validated reference hue (aqua). Below 3:1 on white; relief rule: every chart using it ships direct labels or the table view, and place-type marks always carry a text label." },
      { "set": "categorical", "theme": "light", "color": "#eda100", "reason": "Validated reference hue (yellow). Below 3:1 on white; relief rule (direct labels or table view). Darkening it would collapse it into orange for protan readers." },
      { "set": "categorical", "theme": "light", "color": "#e87ba4", "reason": "Validated reference hue (magenta). Below 3:1 on white; relief rule (direct labels or table view)." },
      { "set": "placeType", "theme": "light", "color": "#1baf7a", "reason": "Villages = aqua. The place-type toggle, legends and direct labels always name it in text, and every chart has a table view." },
      { "set": "status", "theme": "light", "color": "#fab219", "reason": "Status colours never stand alone: always icon + text label, text in warning-text (>= 4.5:1)." },
      { "set": "status", "theme": "light", "color": "#ec835a", "reason": "Status colours never stand alone: always icon + text label." }
    ]
  }
}
