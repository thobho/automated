    "noc": {
      "label": "Noc",
      "chosen": false,
      "rationale": "Pale steel-blue page that turns deep night navy in dark mode, raspberry accent and Atkinson Hyperlegible Next: legibility first, made for evening reading.",
      "fonts": {
        "display": "\"Atkinson Hyperlegible Next Variable\", system-ui, sans-serif",
        "text": "\"Atkinson Hyperlegible Next Variable\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
      },
      "neutral": {
        "0": "#ffffff", "50": "#f0f4fa", "100": "#e3eaf3", "200": "#cfd9e6", "300": "#adbbcd",
        "400": "#8595ab", "500": "#617189", "600": "#48576d", "700": "#344257", "800": "#1f2c40",
        "900": "#0c1a2e", "950": "#06101d"
      },
      "light": {
        "bg-page": "#e7edf6", "bg-surface": "#ffffff", "bg-sunken": "#dbe3ef", "bg-raised": "#ffffff", "bg-inverse": "#0c1a2e",
        "text-primary": "#0c1a2e", "text-secondary": "#3b4a60", "text-muted": "#4a5a72", "text-inverse": "#f0f4fa",
        "accent": "#a8235a", "accent-hover": "#8c1c4a", "accent-subtle": "#f7e2ea", "accent-text": "#9c2154", "text-on-accent": "#ffffff", "link": "#9c2154",
        "border-subtle": "#cfd9e6", "border-strong": "#6b7a91", "focus-ring": "#9c2154",
        "success-text": "#1b6e27", "warning-text": "#7a4900", "danger-text": "#a51f1f", "info-text": "#1a539b",
        "success-subtle": "#e2f2e4", "warning-subtle": "#fbeed2", "danger-subtle": "#f9e3e3", "info-subtle": "#dfeaf8",
        "chart-surface": "#ffffff", "chart-grid": "#e3eaf3", "chart-axis": "#8595ab", "chart-text": "#3b4a60", "chart-annotation": "#0c1a2e",
        "map-boundary": "#ffffff", "map-nodata": "#e3eaf3", "map-nodata-hatch": "#adbbcd", "scrim": "#06101d"
      },
      "dark": {
        "bg-page": "#0a1628", "bg-surface": "#112038", "bg-sunken": "#07101d", "bg-raised": "#182a45", "bg-inverse": "#e3eaf3",
        "text-primary": "#eaf0f8", "text-secondary": "#bac6d8", "text-muted": "#9dabc0", "text-inverse": "#0c1a2e",
        "accent": "#ff7aa8", "accent-hover": "#ff9cbe", "accent-subtle": "#3a1830", "accent-text": "#ff8fb5", "text-on-accent": "#0a1628", "link": "#ff8fb5",
        "border-subtle": "#1f3350", "border-strong": "#6a7f9f", "focus-ring": "#ff8fb5",
