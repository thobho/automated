      "fonts": {
        "display": "\"IBM Plex Sans Variable\", system-ui, sans-serif",
        "text": "\"IBM Plex Sans Variable\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
      },
      "neutral": {
        "0": "#ffffff", "50": "#eef1f3", "100": "#e4e8eb", "200": "#d3d8dc", "300": "#b5bcc1",
        "400": "#8e979d", "500": "#6a7379", "600": "#50585e", "700": "#3b4247", "800": "#272c30",
        "900": "#16191c", "950": "#0d0f11"
      },
      "light": {
        "bg-page": "#e4e8eb", "bg-surface": "#ffffff", "bg-sunken": "#d9dee2", "bg-raised": "#ffffff", "bg-inverse": "#16191c",
        "text-primary": "#16191c", "text-secondary": "#454c52", "text-muted": "#535b61", "text-inverse": "#eef1f3",
        "accent": "#b03a1e", "accent-hover": "#932f17", "accent-subtle": "#f7e4de", "accent-text": "#a33519", "text-on-accent": "#ffffff", "link": "#a33519",
