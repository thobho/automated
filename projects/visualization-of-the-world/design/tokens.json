        "chart-surface": "#ffffff", "chart-grid": "#e4e8eb", "chart-axis": "#8e979d", "chart-text": "#454c52", "chart-annotation": "#16191c",
        "map-boundary": "#ffffff", "map-nodata": "#e4e8eb", "map-nodata-hatch": "#b5bcc1", "scrim": "#0d0f11"
      },
      "dark": {
        "bg-page": "#141618", "bg-surface": "#1d2023", "bg-sunken": "#101214", "bg-raised": "#25292c", "bg-inverse": "#e4e8eb",
        "text-primary": "#eceeef", "text-secondary": "#bcc2c6", "text-muted": "#9aa1a7", "text-inverse": "#16191c",
        "accent": "#f0805c", "accent-hover": "#f59b7d", "accent-subtle": "#3a2119", "accent-text": "#f59b7d", "text-on-accent": "#16191c", "link": "#f59b7d",
        "border-subtle": "#2c3135", "border-strong": "#70787e", "focus-ring": "#f59b7d",
        "success-text": "#5cc26a", "warning-text": "#f0b43c", "danger-text": "#f28b8b", "info-text": "#79b2f0",
        "success-subtle": "#15301a", "warning-subtle": "#3a2a0b", "danger-subtle": "#3d1717", "info-subtle": "#132b49",
        "chart-surface": "#1d2023", "chart-grid": "#2c3135", "chart-axis": "#70787e", "chart-text": "#bcc2c6", "chart-annotation": "#eceeef",
